{
  "name": "xvviix-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:github": "GITHUB_PAGES=true NEXT_PUBLIC_SITE_URL=https://xvviix.github.io next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "npm run build && npm run audit:deps",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "lenis": "1.3.26",
    "next": "16.3.1",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  }
}
